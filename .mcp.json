{
  "mcpServers": {
    "yuandian": {
      "command": "python3",
      "args": ["scripts/yuandian_mcp_bridge.py"],
      "env": {
        "YUANDIAN_API_KEY": "${YUANDIAN_API_KEY}"
      }
    },
    "pkulaw": {
      "command": "python3",
      "args": ["scripts/pkulaw_mcp_bridge.py"],
      "env": {
        "PKULAW_TOKEN": "${PKULAW_TOKEN}"
      }
    }
  }
}