{
  "mcpServers": {
    "yuandian": {
      "command": "python3",
      "args": ["scripts/yuandian_mcp_bridge.py"],
      "env": {
        "YUANDIAN_API_KEY": "${YUANDIAN_API_KEY}"
      }
    },
    "pkulaw": {
      "type": "http",
      "url": "https://apim-gw.pkulaw.com/${PKULAW_SERVICE_ID}/mcp",
      "headers": {
        "Authorization": "Bearer ${PKULAW_API_KEY}"
      }
    }
  }
}