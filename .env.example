# PRC-Law 配置文件示例
# 复制本文件为 .env (本地使用) 或加到 shell rc (推荐 ~/.zshrc 或 ~/.bashrc)
#
# 安全提醒:
# - 任何含 Key 的文件不要 commit 到 git
# - 推荐放 shell rc, 本仓库只保留占位符
# - .env 文件已加入 .gitignore

# =================================================================
# 元典 API Key (商业, 走 credit) — W8 接入
# =================================================================
# 申请地址: https://open.chineselaw.com/
# 免费额度: 每月 5000 次
# 不填则降级到本地 prc-law-data / 政府公开源
YUANDIAN_API_KEY=

# =================================================================
# 北大法宝 PKULAW Token (商业, 走 credit) — W28 接入
# =================================================================
# 注册地址: https://mcp.pkulaw.com/console/points
# 免费额度: 每天 10,000 积分 (当天有效)
# 单价 (积分/次):
#   精准查条/查法规/查案例 (关键词) = 25
#   语义检索 / 案号识别 / 法条识别 / 修正幻觉 / 智能聚合 = 125
# 每天可查 ~400 次精准条, ~80 次语义检索
# 不填则降级到元典单源 + prc-law-data 双源核验 (本地 + 政府公开源)
PKULAW_TOKEN=

# =================================================================
# prc-law-data 数据集路径 (零 credit, 默认首选) — W8 接入
# =================================================================
# 三种对接模式 (按优先级自动探测):
#   1. vendor submodule: vendor/prc-law-data/data/
#   2. 环境变量 PRC_LAW_DATA_DIR: 自定义路径
#   3. HTTP API: PRC_LAW_DATA_URL=http://localhost:8765
# 不填则按优先级探测, 都不可用时降级到本地 cache / 国法库 / 政府公开源
# PRC_LAW_DATA_DIR=
# PRC_LAW_DATA_URL=

# =================================================================
# 配额限制 (W8.2 — 防滥用)
# =================================================================
# 元典 + 北大法宝 共享月配额, 超出后静默降级
# 默认 5000/月
# PRC_LAW_YUANDIAN_QUOTA=5000

# =================================================================
# 离线模式 (W7)
# =================================================================
# PRC_LAW_OFFLINE=1 强制禁用所有网络调用, 仅用本地 cache

# =================================================================
# 自同步 (W7.1)
# =================================================================
# 临时跳过单次会话的自同步检查
# PRC_LAW_SKIP_SYNC=1

# =================================================================
# 工作目录 (W16) — 律师工作目录
# =================================================================
# 不填时自动探测 ~/lawyer-work (Windows: C:/Users/你的名字/lawyer-work)
# PRC_LAW_WORKSPACE_DIR=

# =================================================================
# LLM 切换 (W22) — 满足 PIPL 数据出境合规
# =================================================================
# 商业 API (默认) — Claude / OpenAI / 千问 / DeepSeek
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# 推荐境内 LLM (PIPL 合规): 千问 / DeepSeek
# QWEN_API_KEY=
# DEEPSEEK_API_KEY=